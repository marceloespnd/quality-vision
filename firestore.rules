rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'qa_admin']
      );
    }

    function isEditor() {
      return isSignedIn() && (
        request.auth.token.role in ['editor', 'qa_editor', 'qa_admin'] ||
        isAdmin()
      );
    }

    function isReader() {
      return isSignedIn() && (
        request.auth.token.role in ['viewer', 'editor', 'qa_editor', 'qa_admin'] ||
        isAdmin()
      );
    }

    function validEnStatus(status) {
      return status in ['Finalizado', 'Em andamento', 'Bloqueado', 'Impactado', 'Pendente'];
    }

    function validBugStatus(status) {
      return status in ['Em análise', 'Corrigido', 'Crítico', 'Novo'];
    }

    function isShortText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    match /ens/{enId} {
      allow read: if isReader();

      allow create: if isEditor()
        && request.resource.data.keys().hasOnly([
          'desc', 'type', 'status', 'squad', 'project', 'projectId', 'owner',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && isShortText(request.resource.data.desc, 5, 300)
        && validEnStatus(request.resource.data.status)
        && isShortText(request.resource.data.squad, 2, 80)
        && isShortText(request.resource.data.projectId, 1, 150)
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && isShortText(request.resource.data.owner, 2, 80)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && isShortText(request.resource.data.createdBy, 2, 120)
        && isShortText(request.resource.data.updatedBy, 2, 120);

      allow update: if isEditor()
        && request.resource.data.keys().hasOnly([
          'desc', 'type', 'status', 'squad', 'project', 'projectId', 'owner', 'week', 'bug',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && resource.data.createdAt == request.resource.data.createdAt
        && resource.data.createdBy == request.resource.data.createdBy
        && isShortText(request.resource.data.desc, 5, 300)
        && validEnStatus(request.resource.data.status)
        && isShortText(request.resource.data.squad, 2, 80)
        && isShortText(request.resource.data.projectId, 1, 150)
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && isShortText(request.resource.data.owner, 2, 80)
        && request.resource.data.updatedAt is timestamp
        && isShortText(request.resource.data.updatedBy, 2, 120);

      allow delete: if isAdmin();
    }

    function validOccurrenceScenario(data, index) {
      return data.scenarioIds.size() <= index || (
        data.scenarioIds[index] is string
        && exists(/databases/$(database)/documents/scenarios/$(data.scenarioIds[index]))
        && get(/databases/$(database)/documents/scenarios/$(data.scenarioIds[index])).data.projectId == data.projectId
        && (data.flowId == '' || get(/databases/$(database)/documents/scenarios/$(data.scenarioIds[index])).data.flowId == data.flowId)
      );
    }
    function validOccurrence(data, bug) {
      return data.keys().hasOnly(['desc','owner','developer','squad','severity','status','taskId','scenarioId','scenarioIds','projectId','flowId','blocksExecution','action','startedAt','resolvedAt','createdAt','updatedAt','createdBy','updatedBy'])
        && isShortText(data.desc, 1, 1000) && isShortText(data.owner, 1, 80)
        && data.severity in ['Baixa','Média','Alta','Crítica']
        && (bug ? data.status in ['Novo','Em análise','Em correção','Pronto para reteste','Fechado'] : data.status in ['Aberto','Em tratamento','Resolvido'])
        && data.blocksExecution is bool
        && isShortText(data.projectId, 1, 1500)
        && exists(/databases/$(database)/documents/projects/$(data.projectId))
        && isShortText(data.flowId, 0, 1500)
        && (data.flowId == '' || (exists(/databases/$(database)/documents/flows/$(data.flowId)) && get(/databases/$(database)/documents/flows/$(data.flowId)).data.projectId == data.projectId))
        && data.scenarioIds is list && data.scenarioIds.size() <= 8
        && validOccurrenceScenario(data, 0) && validOccurrenceScenario(data, 1)
        && validOccurrenceScenario(data, 2) && validOccurrenceScenario(data, 3)
        && validOccurrenceScenario(data, 4) && validOccurrenceScenario(data, 5)
        && validOccurrenceScenario(data, 6) && validOccurrenceScenario(data, 7)
        && isShortText(data.action, 0, 2000)
        && isShortText(data.startedAt, 1, 40) && isShortText(data.resolvedAt, 0, 40)
        && validAudit(data);
    }
    match /bugs/{bugId} {
      allow read: if isReader();
      allow create: if isEditor() && validOccurrence(request.resource.data, true);
      allow update: if isEditor() && validOccurrence(request.resource.data, true) && unchangedCreation();
      allow delete: if isAdmin();
    }

    function validAudit(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp
        && isShortText(data.createdBy, 1, 120) && isShortText(data.updatedBy, 1, 120);
    }
    function unchangedCreation() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    match /projects/{projectId} {
      function validProject() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'owner', 'squad', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && isShortText(data.name, 1, 120) && isShortText(data.owner, 1, 80)
          && (!data.keys().hasAny(['squad']) || isShortText(data.squad, 0, 80)) && validAudit(data);
      }
      allow read: if isReader();
      allow create: if isEditor() && validProject();
      allow update: if isEditor() && validProject() && unchangedCreation();
    }
    match /flows/{flowId} {
      function validFlow() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'owner', 'projectId', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && isShortText(data.name, 1, 120) && isShortText(data.owner, 1, 80)
          && isShortText(data.projectId, 1, 1500)
          && exists(/databases/$(database)/documents/projects/$(data.projectId)) && validAudit(data);
      }
      allow read: if isReader();
      allow create: if isEditor() && validFlow();
      allow update: if isEditor() && validFlow() && unchangedCreation()
        && request.resource.data.projectId == resource.data.projectId;
    }
    match /scenarios/{scenarioId} {
      function validScenario() {
        let data = request.resource.data;
        return data.keys().hasOnly(['title', 'description', 'projectId', 'flowId', 'status', 'scriptFile', 'executedAt', 'notes', 'exclusionReason', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && isShortText(data.title, 1, 200) && isShortText(data.description, 0, 2000)
          && isShortText(data.projectId, 1, 1500) && isShortText(data.flowId, 1, 1500)
          && exists(/databases/$(database)/documents/projects/$(data.projectId))
          && exists(/databases/$(database)/documents/flows/$(data.flowId))
          && get(/databases/$(database)/documents/flows/$(data.flowId)).data.projectId == data.projectId
          && data.status in ['Pendente', 'Aprovado', 'Falhado', 'Excluído', 'Bloqueado']
          && isShortText(data.scriptFile, 0, 300) && isShortText(data.notes, 0, 2000)
          && isShortText(data.exclusionReason, 0, 1000)
          && (data.status != 'Excluído' || data.exclusionReason.size() > 0)
          && isShortText(data.executedAt, 0, 10)
          && (!(data.status in ['Aprovado', 'Falhado']) || data.executedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && validAudit(data);
      }
      allow read: if isReader();
      allow create: if isEditor() && validScenario();
      allow update: if isEditor() && validScenario() && unchangedCreation();
    }

    match /impacts/{impactId} {
      allow read: if isReader();
      allow create: if isEditor() && validOccurrence(request.resource.data, false);
      allow update: if isEditor() && validOccurrence(request.resource.data, false) && unchangedCreation();
      allow delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isReader();

      allow create: if isEditor()
        && request.resource.data.keys().hasOnly([
          'message', 'createdAt', 'createdBy'
        ])
        && isShortText(request.resource.data.message, 3, 500)
        && request.resource.data.createdAt is timestamp
        && isShortText(request.resource.data.createdBy, 2, 120);

      allow update: if isEditor()
        && request.resource.data.keys().hasOnly([
          'message', 'createdAt', 'createdBy'
        ])
        && resource.data.createdAt == request.resource.data.createdAt
        && resource.data.createdBy == request.resource.data.createdBy
        && isShortText(request.resource.data.message, 3, 500);

      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isReader();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'successRateTarget', 'slaDays', 'logoPath', 'projectName',
          'squadName', 'managerName', 'qaName', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.successRateTarget is number
        && request.resource.data.successRateTarget >= 0
        && request.resource.data.successRateTarget <= 100
        && request.resource.data.slaDays is number
        && request.resource.data.slaDays >= 0
        && request.resource.data.slaDays <= 365
        && isShortText(request.resource.data.logoPath, 1, 500)
        && isShortText(request.resource.data.projectName, 2, 120)
        && isShortText(request.resource.data.squadName, 2, 80)
        && isShortText(request.resource.data.managerName, 2, 120)
        && isShortText(request.resource.data.qaName, 2, 120)
        && request.resource.data.updatedAt is timestamp
        && isShortText(request.resource.data.updatedBy, 2, 120);

      allow delete: if isAdmin();
    }
  }
}
